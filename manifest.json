{
  "manifest_version": 3,
  "name": "VLA Reviewer",
  "version": "4.0",
  "description": "Checks if the VLA texts meets the required standards",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open VLA Reviewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "optional_host_permissions": [
    "https://data-annotation-app.applied.ondana.ai/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://data-annotation-app.applied.ondana.ai/*"],
      "js": ["zoom.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "run-audit": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Fetch the fields from the page and check VLA compliance"
    },
    "take-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Snip a rectangular screenshot of the annotation page"
    }
  }
}